# This file is the source for HOST-side tooling: running the app locally with
# `uv run uvicorn ...`, Alembic migrations, and the pytest suite.
#
# When you run the app inside Docker (docker compose up), the database URLs and
# other runtime values are injected by compose.yaml using the service hostname
# (fastapi-postgres), so the DB_URL below is NOT used by the container.
DB_URL=postgresql://postgres:1234@localhost:5432/postgres # Used to run the app on your host (localhost = the DB mapped to localhost by compose)
ALEMBIC_DB_URL=postgresql://postgres:1234@localhost:5432/postgres # Used by Alembic, which always runs on the host alongside the exposed DB port
AUTH_SECRET_KEY=your-secret-key # Secret key used to sign JWT tokens (e.g. `openssl rand -hex 32`)
ENVIRONMENT=development # development | production (enables HSTS in production)
LOG_LEVEL=INFO # Python log level
LOG_FORMAT=console # console | json (use json for log aggregators)
CORS_ORIGINS=http://localhost:3000 # Comma-separated list of allowed origins (empty = CORS disabled)
TEST_DB_URL=postgresql://postgres:1234@localhost:5432/postgres_test # Test database used by pytest
